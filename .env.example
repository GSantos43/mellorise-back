NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177
FRONTEND_URL=http://localhost:5177
BFF_PUBLIC_URL=http://localhost:3000
# Production example:
# FRONTEND_ALLOWED_ORIGINS=https://mellorise.shop,https://www.mellorise.shop,https://mellorise-front.vercel.app
CHECKOUT_MAX_ITEM_QUANTITY=12
CHECKOUT_PROVIDER=stripe
# Set CHECKOUT_PROVIDER=woopayments after WooPayments is connected in WordPress.
GEO_ALLOWED_COUNTRIES=US,BR
GEO_DEVELOPMENT_COUNTRY=BR
GEO_IP_PROVIDER_URL=https://ipwho.is/{ip}
GEO_IP_TIMEOUT_MS=2500
GEO_CACHE_TTL_MS=43200000

# Optional server-side funnel logging. Leave empty to log only in container logs.
ANALYTICS_EVENTS_FILE=
ANALYTICS_DASHBOARD_USER=fr4ncev
ANALYTICS_DASHBOARD_PASSWORD=Y3shu4
ANALYTICS_GEO_ENABLED=true
ANALYTICS_GEO_PROVIDER_URL=https://ipwho.is/{ip}
ANALYTICS_GEO_TIMEOUT_MS=2500

# Clerk authentication for protected customer endpoints.
# Enable Google OAuth inside the Clerk dashboard under User & Authentication > Social connections.
CLERK_SECRET_KEY=sk_test_replace_with_clerk_secret_key
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,https://mellorise.shop,https://www.mellorise.shop,https://mellorise-front.vercel.app

# Use http://localhost:8080 when running the BFF on the host.
# Use http://wordpress when running the BFF inside docker-woo.
WOOCOMMERCE_URL=http://localhost:8080
WOOCOMMERCE_PUBLIC_URL=http://localhost:8080
WOOCOMMERCE_SIGNATURE_BASE_URL=http://localhost:8080
WOOCOMMERCE_CONSUMER_KEY=replace_with_woocommerce_consumer_key
WOOCOMMERCE_CONSUMER_SECRET=replace_with_woocommerce_consumer_secret
WOOCOMMERCE_TIMEOUT_MS=8000
WOOPAYMENTS_GATEWAY_ID=woocommerce_payments
WOOPAYMENTS_GATEWAY_TITLE=WooPayments

# Keep Stripe configured as the fallback checkout provider.
STRIPE_SECRET_KEY=sk_test_mocked_for_local_dev
STRIPE_WEBHOOK_SECRET=whsec_mocked_for_local_dev
STRIPE_SHIPPING_COUNTRIES=US,CA,GB,ES
STRIPE_SHIPPING_RATE_NAME=Standard shipping
STRIPE_SHIPPING_RATE_AMOUNT=999
STRIPE_FREE_SHIPPING_RATE_NAME=Free shipping
STRIPE_SHIPPING_MIN_DELIVERY_DAYS=3
STRIPE_SHIPPING_MAX_DELIVERY_DAYS=5
FREE_SHIPPING_VARIATION_IDS=26
STRIPE_SHIPPING_PROTECTION_NAME=Shipping protection
STRIPE_SHIPPING_PROTECTION_AMOUNT=350
STRIPE_AUTOMATIC_TAX_ENABLED=false
STRIPE_TIMEOUT_MS=10000

WELCOME_DISCOUNT_PERCENT=10
WELCOME_DISCOUNT_PREFIX=MELLO10
WELCOME_DISCOUNT_EXPIRATION_HOURS=48
WELCOME_DISCOUNT_FIRST_PURCHASE_STATUSES=processing,completed
WELCOME_DISCOUNT_SHOP_URL=http://localhost:5177/products/wondernest-heightener-gummies-2026

RESEND_API_KEY=replace_with_resend_api_key
MAIL_FROM="MelloRise <hello@your-domain.com>"
MAIL_REPLY_TO=hello@your-domain.com
MAIL_CONTACT_TO=mellorise.support@gmail.com
MAIL_WELCOME_DISCOUNT_ENABLED=true
MAIL_TRACKING_ENABLED=true

# Wiio official WooCommerce flow: connect the WooCommerce store inside Wiio
# using the public WooCommerce URL and read/write REST API keys. With
# WIIO_SYNC_MODE=woocommerce, paid orders are marked in WooCommerce for Wiio to sync.
# If Wiio provides a direct fulfillment API endpoint, use WIIO_SYNC_MODE=direct_api
# and set WIIO_API_URL/WIIO_API_KEY.
WIIO_FULFILLMENT_ENABLED=false
WIIO_SYNC_MODE=woocommerce
WIIO_API_URL=
WIIO_API_KEY=
WIIO_AUTH_HEADER=
WIIO_AUTH_SCHEME=Bearer
WIIO_WEBHOOK_SECRET=replace_with_wiio_tracking_webhook_secret
WIIO_TIMEOUT_MS=10000
